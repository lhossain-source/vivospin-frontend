# Server-side only; never expose these values through VITE_* or NEXT_PUBLIC_* variables.
THE_ODDS_API_KEY=replace_with_your_the_odds_api_key

# PostgreSQL connection string for wallet ledger and settlement transactions.
DATABASE_URL=postgresql://user:password@host:5432/database

# HS256 access-token secret issued by your existing authentication service (minimum 32 bytes).
AUTH_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
# Optional issuer claim expected on user JWTs.
AUTH_JWT_ISSUER=https://your-auth-service.example

# Internal settlement-worker token (minimum 32 characters). Never expose to the browser.
SETTLEMENT_SERVICE_TOKEN=replace_with_a_long_random_internal_token
PG_POOL_MAX=5
# Set to disable only for local development if your database has no TLS.
# PGSSLMODE=disable
