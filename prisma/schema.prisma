// Optional Prisma model for the existing PostgreSQL schema.
// This is a schema reference; the runtime currently uses pg (server/db.ts).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WalletAccount {
  userId      String   @id @map("user_id") @db.Uuid
  currency    String   @db.Char(3)
  balanceMinor BigInt  @default(0) @map("balance_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  ledger      WalletLedger[]
  bets        Bet[]
  settlements SettlementTransaction[]

  @@map("wallet_accounts")
}

model WalletLedger {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  entryType         String   @map("entry_type")
  amountMinor       BigInt   @map("amount_minor")
  balanceAfterMinor BigInt   @map("balance_after_minor")
  currency          String   @db.Char(3)
  referenceType     String   @map("reference_type")
  referenceId       String   @map("reference_id")
  idempotencyKey    String   @unique @map("idempotency_key")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet            WalletAccount @relation(fields: [userId], references: [userId])

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("wallet_ledger")
}

model Bet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventId     String   @map("event_id")
  marketId    String   @map("market_id")
  selectionKey String @map("selection_key")
  stakeMinor  BigInt   @map("stake_minor")
  decimalOdds Decimal @map("decimal_odds") @db.Decimal(12, 4)
  currency    String   @db.Char(3)
  status      String   @default("pending")
  payoutMinor BigInt   @default(0) @map("payout_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(6)
  wallet      WalletAccount @relation(fields: [userId], references: [userId])
  settlement  SettlementTransaction?

  @@index([userId, createdAt(sort: Desc)])
  @@map("bets")
}

model SettlementTransaction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  betId          String   @unique @map("bet_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  outcome        String
  payoutMinor    BigInt   @map("payout_minor")
  currency       String   @db.Char(3)
  idempotencyKey String   @unique @map("idempotency_key")
  settledAt      DateTime @default(now()) @map("settled_at") @db.Timestamptz(6)
  bet            Bet @relation(fields: [betId], references: [id])
  wallet         WalletAccount @relation(fields: [userId], references: [userId])

  @@index([userId, settledAt(sort: Desc)])
  @@map("settlement_transactions")
}
